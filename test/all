#!/bin/bash

# Everything that can be checked without a lock screen and a human thumb.
# Run before publishing, and after every rebase onto a newer built-in.

set -uo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
OMARCHY_LOCK_DIR="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/lock"
UPSTREAM_FILES=(Service.qml LockView.qml manifest.json)

PASSED=0
FAILED=0
SKIPPED=0

pass() { printf '  \e[32m✓\e[0m %s\n' "$1"; PASSED=$((PASSED + 1)); }
skip() { printf '  \e[2m-\e[0m %s \e[2m(skipped: %s)\e[0m\n' "$1" "$2"; SKIPPED=$((SKIPPED + 1)); }
flunk() {
  printf '  \e[31m✗\e[0m %s\n' "$1"
  [[ -n ${2:-} ]] && printf '\e[2m%s\e[0m\n' "$2"
  FAILED=$((FAILED + 1))
}

check() { # description, command...
  local description="$1"; shift
  local output
  if output=$("$@" 2>&1); then pass "$description"; else flunk "$description" "$output"; fi
}

printf '\e[1mManifest\e[0m\n'

check "manifest.json is valid JSON" jq -e . "$REPO/manifest.json"

for field in schemaVersion id name version author description license kinds entryPoints; do
  check "manifest has '$field'" jq -e --arg f "$field" 'has($f)' "$REPO/manifest.json"
done

check "id is not in the reserved omarchy.* namespace" \
  jq -e '.id | startswith("omarchy.") | not' "$REPO/manifest.json"

check "declares kind 'service' with an entry point" \
  jq -e '(.kinds | index("service")) != null and (.entryPoints | has("service"))' "$REPO/manifest.json"

check "declares kind 'panel' with an entry point" \
  jq -e '(.kinds | index("panel")) != null and (.entryPoints | has("panel"))' "$REPO/manifest.json"

check "declares kind 'bar-widget' with an entry point and a barWidget block" \
  jq -e '(.kinds | index("bar-widget")) != null and (.entryPoints | has("barWidget"))
         and (.barWidget | has("displayName") and has("category"))' "$REPO/manifest.json"

check "replaces the built-in lock via clonedFrom" \
  jq -e '.omarchy.clonedFrom == "omarchy.lock"' "$REPO/manifest.json"

check "every entry point exists" bash -c '
  cd "$1" || exit 1
  while IFS= read -r entry; do [[ -f $entry ]] || { echo "missing: $entry"; exit 1; }; done \
    < <(jq -r ".entryPoints[]" manifest.json)' _ "$REPO"

printf '\n\e[1mPlugin folder\e[0m\n'

if command -v omarchy-plugin-validate >/dev/null 2>&1; then
  check "omarchy plugin validate" omarchy-plugin-validate "$REPO"
else
  skip "omarchy plugin validate" "not an Omarchy machine"
fi

# The marketplace picks this up from the repo root for the listing.
check "preview.png is present" test -f "$REPO/preview.png"

# The marketplace counts a manifest.json at the root OR one directory below it
# as a plugin, and rejects a submission carrying more than one. The upstream
# snapshot therefore has to sit two levels down.
check "only the root manifest.json is within the marketplace's reach" bash -c '
  cd "$1" || exit 1
  found=$(git ls-files | grep -E "^([^/]+/)?manifest\\.json$")
  [[ $found == "manifest.json" ]] || { echo "matched: $found"; exit 1; }' _ "$REPO"

check "no symlinks anywhere in the folder" bash -c '
  link=$(find "$1" -name .git -prune -o -type l -print -quit)
  [[ -z $link ]] || { echo "symlink: $link"; exit 1; }' _ "$REPO"

check "bin/omarchy-fido2-suite parses" bash -n "$REPO/bin/omarchy-fido2-suite"
check "bin/omarchy-fido2-suite is executable" test -x "$REPO/bin/omarchy-fido2-suite"

printf '\n\e[1mManagement\e[0m\n'

manage_log=$(mktemp)
if "$REPO/test/manage" >"$manage_log" 2>&1; then
  pass "management subcommands behave ($(grep -c '^  ✓' "$manage_log") assertions)"
else
  flunk "management subcommands behave" "$(cat "$manage_log")"
fi
rm -f "$manage_log"

printf '\n\e[1mQML\e[0m\n'

if command -v qmllint >/dev/null 2>&1 && [[ -d ${OMARCHY_PATH:-/usr/share/omarchy}/shell ]]; then
  check "qmllint Service.qml LockView.qml" \
    qmllint -I "${OMARCHY_PATH:-/usr/share/omarchy}/shell" "$REPO/Service.qml" "$REPO/LockView.qml"
  check "qmllint ManagementPanel.qml and its components" \
    qmllint -I "${OMARCHY_PATH:-/usr/share/omarchy}/shell" \
      "$REPO/ManagementPanel.qml" "$REPO/Notice.qml" "$REPO/WiringRow.qml"
  check "qmllint BarWidget.qml" \
    qmllint -I "${OMARCHY_PATH:-/usr/share/omarchy}/shell" "$REPO/BarWidget.qml"
else
  skip "qmllint" "qmllint or the Omarchy shell is not installed"
fi

# The whole point of a separate PAM service: no path may exist that sends a
# password to the key. If the FIDO2 conversation ever borrows the password
# buffer, that guarantee is gone.
check "the FIDO2 flow never responds with the password buffer" bash -c '
  ! grep -nE "fido2Pam\.respond\((pendingPassword|enteredPassword)" "$1/Service.qml"' _ "$REPO"
check "the password flow never responds with the PIN buffer" bash -c '
  ! grep -nE "passwordPam\.respond\(pendingFido2Pin" "$1/Service.qml"' _ "$REPO"
check "the FIDO2 PAM service is not shared with the password one" bash -c '
  ! grep -n "config: \"omarchy-lock-password\"" "$1/Service.qml" | grep -q fido2' _ "$REPO"

# An empty Text is valid QML, lints clean, and draws nothing at zero width, so
# a glyph lost in an edit leaves no trace anywhere except a lock screen with a
# missing icon. This shipped once.
check "the security-key glyph is not empty" bash -c '
  grep -A 10 "objectName: \"fido2Indicator\"" "$1/LockView.qml" \
    | grep -qE "^\s+text: \"[^\"]+\"$"' _ "$REPO"

# Both presence settings are opt-in. A truthy test would turn lockOnUnplug on
# for anyone who wrote "false" as a string, and locking someone's session is
# not a thing to do by accident.
check "presence settings are off unless set to exactly true" bash -c '
  grep -q "settings.lockOnUnplug === true" "$1/Service.qml" \
    && grep -q "settings.notifyOnKeyChange === true" "$1/Service.qml"' _ "$REPO"

# Unlocking on resume is only sound behind disk encryption, which nothing here
# can verify, so it has to be asked for in so many words.
check "unlock after hibernate is off unless set to exactly true" bash -c '
  grep -q "settings.unlockAfterHibernate === true" "$1/Service.qml"' _ "$REPO"

# An enrollment running in a terminal holds the key, so an enumeration can
# come back empty while the key is still plugged in. Locking on that reading
# would lock the screen under a user halfway through typing a PIN.
check "an unplug is confirmed before it locks anything" bash -c '
  grep -q "fido2AbsencePending" "$1/Service.qml" \
    && grep -q "fido2AbsenceConfirmTimer" "$1/Service.qml"' _ "$REPO"

# The panel displays state and launches terminals; the moment it runs sudo (or
# anything else privileged) itself, the "the shell never runs privileged code"
# promise in the README and the marketplace submission stops being true.
check "the panel never runs a privileged command itself" bash -c '
  ! grep -nE "^[^/]*(command:|execDetached)" "$1/ManagementPanel.qml" \
    | grep -qE "sudo|pkexec|\binstall\b|tee"' _ "$REPO"
check "every panel action goes through the terminal wrapper" bash -c '
  ! grep -n "execDetached" "$1/ManagementPanel.qml" \
    | grep -qv "omarchy-launch-floating-terminal-with-presentation"' _ "$REPO"

printf '\n\e[1mUntrusted input\e[0m\n'

# A credential label is typed by whoever enrolled the key; a token name is
# whatever string the USB device chose to report. Both are rendered, and QML's
# default textFormat is AutoText -- it sniffs for markup and will happily parse
# a label as rich text and fetch whatever an <img src> in it points at.
check "every Text pins textFormat to PlainText" bash -c '
  cd "$1" || exit 1
  opens=$(grep -c "^\s*Text {\s*$" ./*.qml | awk -F: "{n += \$2} END {print n + 0}")
  plain=$(grep -c "textFormat: Text.PlainText" ./*.qml | awk -F: "{n += \$2} END {print n + 0}")
  [[ $opens -gt 0 && $opens -eq $plain ]] || { echo "$opens Text blocks, $plain pinned to PlainText"; exit 1; }' _ "$REPO"

# Every collected stream is a buffer that grows to whatever the child writes,
# and every command that touches a key or a DBus service can stop answering.
check "every collected command carries a deadline and a ceiling" bash -c '
  cd "$1" || exit 1
  for file in Service.qml ManagementPanel.qml; do
    collectors=$(grep -c "StdioCollector" "$file")
    (( collectors == 0 )) && continue
    grep -q "timeout -k" "$file" || { echo "$file collects output with no deadline"; exit 1; }
    grep -q "head -c" "$file" || { echo "$file collects output with no ceiling"; exit 1; }
  done' _ "$REPO"

check "the panel caps how many rows it will build" bash -c '
  grep -q "slice(0, maxRows)" "$1/ManagementPanel.qml"' _ "$REPO"

# The producer is the real bound: the panel polls, so an unbounded enumeration
# is an unbounded call repeated forever.
check "state caps its enumerations and reports the true totals" bash -c '
  set -euo pipefail
  out=$(OMARCHY_FIDO2_MAX_CREDENTIALS=1 "$1/bin/omarchy-fido2-suite" state)
  jq -e ".credentials | length <= 1" <<<"$out" >/dev/null
  jq -e "has(\"counts\") and has(\"limits\") and has(\"truncated\")" <<<"$out" >/dev/null
  jq -e ".counts.credentials >= (.credentials | length)" <<<"$out" >/dev/null' _ "$REPO"

check "a label carrying escapes and markup is stripped and clipped" bash -c '
  set -euo pipefail
  # Source the helpers without running a command.
  eval "$(sed -n "/^MAX_FIELD_CHARS=/p;/^sanitize_field()/,/^}/p" "$1/bin/omarchy-fido2-suite")"
  MAX_FIELD_CHARS=16
  got=$(sanitize_field "$(printf "a\033[31mb\nc\td")<img src=x>eeeeeeeeeeeeeeeeeeee")
  [[ $got != *$"\033"* ]] || { echo "escape survived: $got"; exit 1; }
  [[ $got != *$"\n"* ]]   || { echo "newline survived"; exit 1; }
  (( ${#got} <= 16 ))      || { echo "not clipped: ${#got} chars"; exit 1; }' _ "$REPO"

check "removal still sees every credential, cap or no cap" bash -c '
  # credentials() must stay uncapped: cmd_remove_credential rewrites the
  # mapping file from it, and a truncated list would delete the remainder.
  ! sed -n "/^credentials()/,/^}/p" "$1/bin/omarchy-fido2-suite" | grep -q "head -n"' _ "$REPO"

printf '\n\e[1mUpstream\e[0m\n'

if [[ ! -d $OMARCHY_LOCK_DIR ]]; then
  skip "fork base matches the installed lock plugin" "$OMARCHY_LOCK_DIR not found"
else
  for file in "${UPSTREAM_FILES[@]}"; do
    recorded=$(grep -oP "^sha256_$file=\K.*" "$REPO/upstream/lock/BASE" 2>/dev/null)
    snapshot=$(sha256sum "$REPO/upstream/lock/$file" 2>/dev/null | cut -d' ' -f1)
    installed=$(sha256sum "$OMARCHY_LOCK_DIR/$file" 2>/dev/null | cut -d' ' -f1)

    if [[ -z $recorded || -z $snapshot ]]; then
      flunk "upstream/lock/$file is recorded in BASE"
    elif [[ $recorded != "$snapshot" ]]; then
      flunk "upstream/lock/$file matches its hash in BASE" "recorded $recorded, file $snapshot"
    elif [[ $recorded != "$installed" ]]; then
      flunk "upstream/lock/$file matches the installed lock plugin" \
        "upstream has moved -- run: bin/omarchy-fido2-suite rebase"
    else
      pass "upstream/lock/$file is current"
    fi
  done
fi

printf '\n%d passed, %d failed, %d skipped\n' "$PASSED" "$FAILED" "$SKIPPED"
(( FAILED == 0 ))
